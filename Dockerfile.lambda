# Container image for AWS Lambda (x86_64).
# Models are loaded from S3 at runtime (MODELS_BUCKET env var), so they are
# not baked into the image.
FROM public.ecr.aws/lambda/python:3.12

# Install Python dependencies into the Lambda task root.
# Pinned to match the versions the models were trained with (sklearn 1.3.x,
# xgboost 2.0.0, numpy 1.26.4) so the pickled models load cleanly.
RUN pip install --no-cache-dir \
    flask==3.0.0 \
    apig-wsgi==2.18.0 \
    requests==2.31.0 \
    numpy==1.26.4 \
    scikit-learn==1.3.2 \
    xgboost==2.0.0 \
    cohere==5.13.3 \
    PyYAML==6.0.2

# Copy application code into the task root.
COPY app.py lambda_function.py ${LAMBDA_TASK_ROOT}/
COPY templates ${LAMBDA_TASK_ROOT}/templates
COPY static ${LAMBDA_TASK_ROOT}/static
COPY ml_training ${LAMBDA_TASK_ROOT}/ml_training
# Coaching layer + its pre-built embedding cache (read-only at runtime).
COPY coaching ${LAMBDA_TASK_ROOT}/coaching

# Lambda handler: module.function
CMD ["lambda_function.lambda_handler"]
